# Matches the root .npmrc. Required because npm does NOT walk up to parent
# directories for .npmrc, so installs run from server/ would otherwise fail on a
# pre-existing peer conflict: better-auth@1.4.7 declares peerOptional
# drizzle-orm@^0.41.0 while this project pins drizzle-orm@^0.38.3.
#
# This file is also copied into the deploy package by build-unified.bat so that
# `npm install --production` on Hostinger resolves the same way.
legacy-peer-deps=true

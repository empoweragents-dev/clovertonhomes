# Hostinger injects PORT automatically. Do not add PORT manually in hPanel.
NODE_ENV=production

# Hostinger MySQL (copy the host, user, and database name from hPanel)
# URL-encode special characters in the password.
DATABASE_URL=mysql://HOSTINGER_DB_USER:URL_ENCODED_PASSWORD@HOSTINGER_DB_HOST:3306/HOSTINGER_DB_NAME

# Uploaded images. Point this OUTSIDE the git deployment directory, or every
# deploy replaces the checkout and takes the uploaded images with it.
UPLOAD_DIR=/home/HOSTINGER_ACCOUNT/private/cloverton-uploads

# Better Auth (generate a unique secret with: openssl rand -base64 32)
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters-long
BETTER_AUTH_URL=https://clovertonhomes.com.au
BETTER_AUTH_TRUSTED_ORIGINS=https://clovertonhomes.com.au,https://www.clovertonhomes.com.au

# Public application URLs
FRONTEND_URL=https://clovertonhomes.com.au
NEXT_PUBLIC_SITE_URL=https://clovertonhomes.com.au

# Persistent writable directory outside the Git deployment directory
DOCUMENT_STORAGE_DIR=/home/HOSTINGER_ACCOUNT/private/cloverton-documents

# Optional legacy Brevo integration
BREVO_API_KEY=your-brevo-api-key

# Hostinger SMTP
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@clovertonhomes.com.au
SMTP_PASS=your-mailbox-password
MAIL_TO=info@clovertonhomes.com.au
MAIL_FROM=info@clovertonhomes.com.au

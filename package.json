{
  "name": "cloverton-homes",
  "version": "0.1.0",
  "description": "Cloverton Homes Express application",
  "private": true,
  "main": "app.js",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run build:server && npm run build:web",
    "build:server": "npx tsc --project server/tsconfig.json",
    "build:web": "next build",
    "start": "node app.js",
    "lint": "next lint",
    "db:push": "cd server && drizzle-kit push",
    "db:studio": "cd server && drizzle-kit studio"
  },
  "dependencies": {
    "@getbrevo/brevo": "^3.0.1",
    "@react-pdf/renderer": "4.6.1",
    "@supabase/supabase-js": "^2.47.10",
    "@tailwindcss/forms": "^0.5.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^20",
    "@types/nodemailer": "^6.4.24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.0.1",
    "better-auth": "^1.2.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jspdf": "^4.2.1",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.22.5",
    "next": "^16.0.10",
    "nodemailer": "^9.1.1",
    "pdf-lib": "1.17.1",
    "postcss": "^8",
    "postgres": "^3.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "slugify": "^1.6.6",
    "tailwindcss": "^3.3.0",
    "typescript": "^5",
    "uuid": "^11.0.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.19.2"
  }
}
